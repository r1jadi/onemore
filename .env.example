[TEMPLATE]
# ─────────────────────────────────────────────────────────────────────────────
# onemore environment template.
#
# Copy the names you need into `.env.local` (development), or set them in the
# host's environment (Vercel for the web app, the API host's secret store for the
# Go services). This file is the only committed env file and contains names,
# defaults and comments — never a secret value.
#
# Two classes of configuration, and a value never moves between them:
#
#   PUBLIC  (prefix VITE_)    Compiled into the browser bundle. Only the Supabase
#                             URL and the *publishable* key belong here; Supabase
#                             designs both to be readable by anyone. Row Level
#                             Security is the security boundary, not secrecy.
#   SERVER  (everything else) Read only by the SSR server, TanStack Start server
#                             functions and the Go services.
#
# Every variable below says where a human actually gets its value. The same
# information as a table, plus the dashboard paths and CLI commands, is in
# docs/development/environments.md#how-to-find-each-value.
#
# `.env`, `.env.*` and `.env.*.local` are gitignored, so a secret that is pasted
# here and committed is treated as leaked by the `gitleaks` CI job — rotate it.
# ─────────────────────────────────────────────────────────────────────────────

# ── Web: public frontend configuration ───────────────────────────────────────
# Supabase project URL. Not secret: it is in every request the browser makes.
# Find it: Supabase dashboard → Project Settings → API Keys → Project URL
#          (also shown in the project's Connect dialog, and as the "Reference ID"
#          host: https://<project-ref>.supabase.co).
# Local:   `supabase status` → APIs → Project URL (http://127.0.0.1:54321).
VITE_SUPABASE_URL=
# Supabase *publishable* key, the current name for what used to be the anon key.
# Format: sb_publishable_... (a short string, deliberately NOT a JWT). Supabase is
# deprecating the anon key, so new work uses this one. Safe to ship: it only
# reaches what Row Level Security allows.
# Find it: Supabase dashboard → Project Settings → API Keys → "Publishable and
#          secret API keys" tab → the publishable key named `default`. If that tab
#          shows "Create new API keys", create them; both key systems work at the
#          same time.
# Local:   `supabase status` → Authentication Keys → Publishable (CLI 2.45+;
#          `supabase status -o env` prints PUBLISHABLE_KEY and SECRET_KEY).
# Legacy:  VITE_SUPABASE_ANON_KEY is still read as a fallback so an existing
#          Vercel project keeps working, but it is deprecated — prefer this name.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Canonical origin used for SEO (canonical URLs, Open Graph, sitemap).
# Changing this one value moves canonical links, og:url and the sitemap origin;
# a custom domain is therefore an environment change, not a code change.
# Find it: it is whatever domain the app is served from — the custom domain once
#          one exists, otherwise https://onemorestartup.vercel.app.
VITE_PUBLIC_SITE_URL=https://onemorestartup.vercel.app
# Base URL of the Go API. Empty means same-origin "/api/v1".
# Local development: http://localhost:8080/api/v1 (the gateway default below).
# Find it: the deployed gateway's origin. Leave it empty until an API host
#          exists — the app then calls its own origin and fails predictably.
VITE_API_BASE_URL=

# ── Web: server-only configuration ───────────────────────────────────────────
# Supabase *secret* key, the current name for what used to be the service_role
# key. Format: sb_secret_... It bypasses Row Level Security, so it is server-only:
# never a VITE_ variable, never in a client component, never in a bundle.
# Nothing reads it yet — it is reserved for privileged server-side work (see
# docs/security/env-and-secrets.md). Create one key per backend component so a
# single leak only forces one rotation, and note that a secret key is rejected
# with 401 if it is used from a browser.
# Find it: Supabase dashboard → Project Settings → API Keys → "Publishable and
#          secret API keys" tab → create or reveal a secret key named `default`.
# Local:   `supabase status` → Authentication Keys → Secret.
# Legacy:  SUPABASE_SERVICE_ROLE_KEY is the deprecated equivalent.
SUPABASE_SECRET_KEY=

# ── Go services ──────────────────────────────────────────────────────────────
# Read by every service in services/*. Defaults are safe for local development;
# ENVIRONMENT is the one value that changes behaviour (see config.Validate).
ENVIRONMENT=development
SERVICE_NAME=gateway
HTTP_ADDR=:8080
LOG_LEVEL=info
LOG_FORMAT=json
# Comma-separated allowlist. "*" is rejected outside development, and an empty
# list is rejected in production.
# Find it: the exact origins the web app is served from — the dev server for
#          local work, the Vercel production domain (and preview domains) beyond.
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:3000
# Rate limiting is on by default and cannot be disabled in production.
RATE_LIMIT_ENABLED=1
RATE_LIMIT_REQUESTS_PER_MINUTE=600
RATE_LIMIT_BURST=60

# Supabase project metadata for token verification (no secrets here).
# SUPABASE_URL is the same value as VITE_SUPABASE_URL above.
SUPABASE_URL=
# Optional. Leave empty: when SUPABASE_URL is set the service derives
#   <SUPABASE_URL>/auth/v1/.well-known/jwks.json
# which is the project's published key set. Set it only to point somewhere else
# (for example a self-hosted Auth). You can paste the derived URL into a browser
# to confirm it returns JSON — it is public and safe to look at.
SUPABASE_JWKS_URL=
# Fixed for Supabase-issued access tokens. Change it only for third-party auth.
SUPABASE_JWT_AUDIENCE=authenticated
# Optional. Derived as <SUPABASE_URL>/auth/v1 when empty.
SUPABASE_JWT_ISSUER=
# LEGACY. The shared HS256 secret from the old JWT system; read only by a project
# that has not migrated to signing keys. Prefer the JWKS path above, which needs
# no secret and allows key rotation without a redeploy. Treat this value as a
# master credential — anyone holding it can mint a token for any user.
# Find it: Supabase dashboard → Project Settings → API Keys → "JWT signing keys".
#          Migrating there imports the legacy secret into the new system and
#          creates a rotatable ES256/RS256 key; once your tokens are asymmetric,
#          delete this variable and verify against the JWKS instead.
#          Use `supabase gen signing-key --algorithm ES256` to bring your own key.
SUPABASE_JWT_SECRET=

# Comma-separated upstream base URLs, one per service the gateway proxies.
# Empty values make the gateway answer 503 for that route group, which is the
# intended behaviour before an API host exists.
# Find it: the private address of each deployed service. Locally every service
#          listens on its own HTTP_ADDR; run only the ones you need.
UPSTREAM_AUTH_URL=
UPSTREAM_USERS_URL=
UPSTREAM_GAMES_URL=
UPSTREAM_GAME_SESSIONS_URL=
UPSTREAM_SCORES_URL=
UPSTREAM_LEADERBOARDS_URL=
UPSTREAM_FEED_URL=
UPSTREAM_RECOMMENDATIONS_URL=
UPSTREAM_SOCIAL_URL=
UPSTREAM_NOTIFICATIONS_URL=
UPSTREAM_SEARCH_URL=
UPSTREAM_MODERATION_URL=
UPSTREAM_ANALYTICS_URL=
UPSTREAM_ADMIN_URL=

# ── Deferred (documented, not implemented in this phase) ─────────────────────
# Payments will run through RaiAccept from the Go payments service. No keys are
# read until that service is implemented — see docs/decisions/0005-payments.md.
# Find them: the RaiAccept merchant dashboard, which issues the API base URL, the
#            API key and the webhook signing secret for your merchant account.
RAIACCEPT_API_BASE_URL=
RAIACCEPT_API_KEY=
RAIACCEPT_WEBHOOK_SECRET=
