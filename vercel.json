{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "./",
      "framework": "tanstack-start-lovable"
    },
    "api": {
      "root": "./",
      "runtime": "container",
      "entrypoint": "Dockerfile.vercel",
      "bindings": [
        {
          "type": "service",
          "service": "auth",
          "format": "url",
          "env": "UPSTREAM_AUTH_URL"
        }
      ]
    },
    "auth": {
      "root": "services/",
      "framework": "go",
      "entrypoint": "cmd/server/main.go"
    }
  },
  "rewrites": [
    {
      "source": "/api/v1",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/api/v1/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/healthz",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/readyz",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
